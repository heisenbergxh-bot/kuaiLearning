[Unit]
Description=KuaiLearning API
After=network.target mysqld.service
Wants=mysqld.service

[Service]
Type=simple
User=kuailearning
Group=kuailearning
WorkingDirectory=/opt/kuailearning/api-current/kuaiLearning-api
EnvironmentFile=/opt/kuailearning/api.env
ExecStart=/opt/kuailearning/api-current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --log-level info
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
