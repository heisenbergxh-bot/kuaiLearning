APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# MySQL 8.0+; encode special characters in the password.
DATABASE_URL=mysql+asyncmy://kuailearning:change-me@127.0.0.1:3306/kuailearning?charset=utf8mb4
DATABASE_ECHO=false

# Authentication is owned by the future unified-login service.
# development: accept X-Debug-User only for local development.
# external: reject protected requests until the external adapter is configured.
AUTH_MODE=development

# OpenAI-compatible model endpoint used by AgentScope.
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_SECONDS=180
