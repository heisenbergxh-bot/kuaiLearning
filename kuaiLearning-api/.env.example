APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# MySQL 8.0+; encode special characters in the password.
DATABASE_URL=mysql+asyncmy://kuailearning:change-me@127.0.0.1:3306/kuailearning?charset=utf8mb4
DATABASE_ECHO=false

# Authentication is owned by the future unified-login service.
# development: accept X-Debug-User only for local development.
# external: reject protected requests until the external adapter is configured.
AUTH_MODE=development

# Browser-visible KuaiLearning origin. No trailing slash.
PUBLIC_BASE_URL=http://81.71.157.238:8081

# Casdoor OIDC. Obtain the secret through a secure channel.
CASDOOR_ISSUER=http://81.71.157.238:8080
CASDOOR_CLIENT_ID=auth-center
CASDOOR_CLIENT_SECRET=
CASDOOR_REDIRECT_URI=http://81.71.157.238:8081/api/v1/auth/callback
SESSION_COOKIE_NAME=kuailearning_session
SESSION_TTL_SECONDS=28800
OIDC_STATE_TTL_SECONDS=600
# Keep false only while the documented HTTP deployment remains in use.
COOKIE_SECURE=false

# OpenAI-compatible model endpoint used by AgentScope.
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_SECONDS=180

# Exact subject IDs from GET /api/v1/me (JSON array); empty disables configuration writes.
AI_CONFIG_ADMIN_SUBJECTS=[]
# Generate once with Fernet.generate_key(); preserve across restarts and database restores.
AI_CONFIG_ENCRYPTION_KEY=
